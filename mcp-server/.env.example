# Copy to mcp-server/.env and fill with the matching Baton project values.
BATON_API_URL=https://your-baton-api.example
BATON_API_KEY=
BATON_ORG_ID=
BATON_REPOSITORY_ID=
BATON_REPO_PATH=/absolute/path/to/your/repository
# Optional: share a stable ID across client restarts if the caller has one.
# BATON_SESSION_ID=
