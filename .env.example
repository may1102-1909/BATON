# Supabase (https://supabase.com/dashboard/project/_/settings/api)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Browser Supabase settings baked in at build time. The build accepts VITE_*, NEXT_PUBLIC_* or the plain
# SUPABASE_URL / SUPABASE_ANON_KEY above; set whichever your host provides. Never put the service-role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public base URL of this app; the GitHub OAuth callback is <PUBLIC_APP_URL>/api/github/callback
PUBLIC_APP_URL=http://localhost:3000

# Google Gemini (optional; without it handovers use the evidence-only compiler)
GEMINI_API_KEY=your-gemini-api-key
# Optional: one model name for every generation request (default gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# AES-256 key for stored GitHub tokens (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
TOKEN_ENCRYPTION_KEY=your-32-byte-base64-encryption-key

# GitHub App (https://github.com/settings/apps/your-app)
GITHUB_APP_ID=your-github-app-id
GITHUB_APP_SLUG=your-github-app-slug
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# Optional comma-separated CORS allow-list
# BATON_ALLOWED_ORIGINS=https://your-domain.example

# Test/offline switch that swaps Supabase for a seeded in-memory store. Keep false in production.
BATON_DEMO_MODE=false
