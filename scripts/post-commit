#!/bin/sh
# Baton auto-sync post-commit hook
# Runs in background so developer commits are never slowed or blocked

if command -v baton >/dev/null 2>&1; then
  ( baton sync --commit HEAD >/dev/null 2>&1 & )
elif [ -f "mcp-server/dist/cli.js" ]; then
  ( node mcp-server/dist/cli.js sync --commit HEAD >/dev/null 2>&1 & )
fi
