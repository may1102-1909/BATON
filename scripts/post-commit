#!/bin/sh
# Optional local capture; GitHub App webhooks are the primary repository source.
[ -n "$BATON_API_KEY" ] && [ -n "$BATON_API_URL" ] && [ -n "$BATON_ORG_ID" ] || exit 0
node --input-type=module <<'JS' >/dev/null 2>&1 &
import {execFileSync} from 'node:child_process';
import {redactData} from './server/redact.js';
try {
  const git = (...args) => execFileSync('git',args,{encoding:'utf8'}).trim();
  const sha=git('rev-parse','HEAD');
  const content=redactData(git('log','-1','--format=%B'));
  await fetch(`${process.env.BATON_API_URL.replace(/\/$/,'')}/api/collector/push`,{
    method:'POST',headers:{'Content-Type':'application/json',Authorization:`Bearer ${process.env.BATON_API_KEY}`},
    body:JSON.stringify({type:'commit',content,org_id:process.env.BATON_ORG_ID,repository_id:process.env.BATON_REPOSITORY_ID,session_id:'git-hook',event_id:sha,metadata:{sha,source:'optional-local-hook'}}),
    signal:AbortSignal.timeout(5000),
  });
} catch {}
JS
exit 0
